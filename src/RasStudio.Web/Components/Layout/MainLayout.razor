@inherits LayoutComponentBase

<AppThemeProvider/>

<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <AppBrand/>
    </MudAppBar>

    <MudDrawer id="nav-drawer" Variant="DrawerVariant.Mini" Breakpoint="Breakpoint.None"
               ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent Class="pt-16">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    RasStudio Mono encountered an unexpected error.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">×</span>
</div>
