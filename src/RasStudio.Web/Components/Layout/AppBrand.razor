<div class="app-brand">
    <CosmicBrandMark/>

    <span class="app-brand-copy">
        <span class="app-brand-title">
            <a href="/" class="app-brand-home-link">@Title</a>
        </span>

        @if (!string.IsNullOrWhiteSpace(Badge))
        {
            <span class="app-brand-badge">
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                    @Badge
                </MudChip>
            </span>
        }

    </span>
</div>

@code {
    [Parameter] public string Title { get; set; } = "RasStudio Mono";
    [Parameter] public string? Badge { get; set; } = "ALPHA";
}
