<div class="app-brand">
    <CosmicBrandMark/>

    <span class="app-brand-copy">
        <span class="app-brand-title">
            <a href="/" class="app-brand-home-link">@Title</a>
        </span>

        @if (RasStudioVersion.PrereleaseLabel is not null)
        {
            <span class="app-brand-badge">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="Color.Warning"
                         Variant="Variant.Outlined">
                    @RasStudioVersion.PrereleaseLabel
                </MudChip>
            </span>
        }

        <span class="app-brand-version">
            @RasStudioVersion.Display
        </span>
    </span>
</div>

@code {
    [Parameter] public string Title { get; set; } = "RasStudio Mono";
}
