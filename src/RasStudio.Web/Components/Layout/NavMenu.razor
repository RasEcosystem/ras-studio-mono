@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="nav-menu" aria-label="Primary navigation">
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudTooltip Text="Home" Placement="Placement.Right" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.Home" Href="/"
                           Color="@GetRouteColor(string.Empty)" Size="Size.Medium"
                           Variant="Variant.Text" aria-label="Home"/>
        </MudTooltip>

        <MudDivider Style="width: 100%; margin-bottom: 4px;"/>

        <MudTooltip Text="RasGates" Placement="Placement.Right" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.SettingsEthernet" Href="/ras-gates"
                           Color="@GetRouteColor("ras-gates")" Size="Size.Medium"
                           Variant="Variant.Text" aria-label="RasGates"/>
        </MudTooltip>

        <MudTooltip Text="Clusters" Placement="Placement.Right" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.Storage" Href="/clusters"
                           Color="@GetRouteColor("clusters")" Size="Size.Medium"
                           Variant="Variant.Text" aria-label="Clusters"/>
        </MudTooltip>

    </MudStack>

    <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="nav-menu-bottom">
        <MudDivider Style="width: 100%; margin-bottom: 4px;"/>

        <MudTooltip Text="Settings" Placement="Placement.Right" Arrow="true">
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Href="/settings"
                           Color="@GetRouteColor("settings")" Size="Size.Medium"
                           Variant="Variant.Text" aria-label="Settings"/>
        </MudTooltip>
    </MudStack>
</nav>

@code {
    private string _currentUrl = string.Empty;

    protected override void OnInitialized()
    {
        UpdateCurrentUrl(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private Color GetRouteColor(string route)
    {
        return IsRouteActive(route)
            ? Color.Primary
            : Color.Default;
    }

    private bool IsRouteActive(string route)
    {
        if (string.IsNullOrEmpty(route))
        {
            return string.IsNullOrEmpty(_currentUrl);
        }

        return _currentUrl.Equals(route, StringComparison.OrdinalIgnoreCase)
               || _currentUrl.StartsWith($"{route}/", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateCurrentUrl(args.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentUrl(string location)
    {
        _currentUrl = NavigationManager
            .ToBaseRelativePath(location)
            .Split('?', '#')[0]
            .Trim('/');
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}
