<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="@Severity" Variant="Variant.Outlined" Dense>
                @Description
            </MudAlert>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Credentials are sent only with this request and are not saved by RasStudio.
            </MudText>
            <MudTextField T="string"
                          @bind-Value="_user"
                          Label="Cluster administrator"
                          Variant="Variant.Outlined"
                          MaxLength="512"/>
            <MudTextField T="string"
                          @bind-Value="_password"
                          Label="Cluster password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          MaxLength="512"/>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense>
                    @_error
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Row Justify="Justify.FlexEnd" Spacing="2" Class="px-4 pb-4" Style="width: 100%;">
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="@ActionColor"
                       StartIcon="@ActionIcon"
                       OnClick="Submit">
                @ActionText
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    private string? _user;
    private string? _password;
    private string? _error;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Description { get; set; } = "Enter credentials if the cluster requires them.";

    [Parameter] public string ActionText { get; set; } = "Continue";

    [Parameter] public string ActionIcon { get; set; } = Icons.Material.Outlined.Sync;

    [Parameter] public Color ActionColor { get; set; } = Color.Primary;

    [Parameter] public Severity Severity { get; set; } = Severity.Info;

    private void Submit()
    {
        _error = null;
        var user = Normalize(_user);
        var password = PreserveSecret(_password);
        if (password is not null && user is null)
        {
            _error = "Cluster administrator is required when a password is provided.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new ClusterCredentialsValues(user, password)));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private static string? Normalize(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private static string? PreserveSecret(string? value)
    {
        return string.IsNullOrEmpty(value) ? null : value;
    }

}
