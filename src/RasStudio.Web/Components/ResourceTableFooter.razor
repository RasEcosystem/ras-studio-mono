<div class="mud-table-pagination resource-table-pagination">
    <MudToolBar Class="mud-table-pagination-toolbar mud-tablepager-left">
        <div class="mud-table-pagination-spacer"></div>
        <div class="mud-table-pagination-display mud-tablepager-left">
            <div class="mud-table-pagination-caption">
                <div class="mud-table-pagination-information">Rows per page:</div>
            </div>
            <CascadingValue Name="SubscribeToParentForm" Value="false" IsFixed>
                <MudSelect T="int"
                           Value="@PageSize"
                           ValueChanged="ChangePageSizeAsync"
                           Class="mud-table-pagination-select"
                           Underline="false"
                           Dense
                           SelectionOnEnter
                           Disabled="@Disabled"
                           aria-label="Rows per page">
                    @foreach (var pageSize in PageSizes)
                    {
                        <MudSelectItem Value="@pageSize">@pageSize</MudSelectItem>
                    }
                </MudSelect>
            </CascadingValue>
        </div>
        <div class="mud-table-pagination-caption">
            <div class="mud-table-page-number-information">
                @FirstItem-@LastItem of @TotalCount
            </div>
        </div>
        <div class="mud-table-pagination-actions">
            <MudIconButton Class="mud-flip-x-rtl mud-table-pagination-first-button"
                           Icon="@Icons.Material.Filled.FirstPage"
                           Disabled="@(Disabled || TotalCount == 0 || PageNumber <= 1)"
                           OnClick="@(() => ChangePageAsync(1))"
                           aria-label="First page"/>
            <MudIconButton Class="mud-flip-x-rtl mud-table-pagination-before-button"
                           Icon="@Icons.Material.Filled.NavigateBefore"
                           Disabled="@(Disabled || TotalCount == 0 || PageNumber <= 1)"
                           OnClick="@(() => ChangePageAsync(PageNumber - 1))"
                           aria-label="Previous page"/>
            <MudIconButton Class="mud-flip-x-rtl mud-table-pagination-next-button"
                           Icon="@Icons.Material.Filled.NavigateNext"
                           Disabled="@(Disabled || TotalCount == 0 || PageNumber >= TotalPages)"
                           OnClick="@(() => ChangePageAsync(PageNumber + 1))"
                           aria-label="Next page"/>
            <MudIconButton Class="mud-flip-x-rtl mud-table-pagination-last-button"
                           Icon="@Icons.Material.Filled.LastPage"
                           Disabled="@(Disabled || TotalCount == 0 || PageNumber >= TotalPages)"
                           OnClick="@(() => ChangePageAsync(TotalPages))"
                           aria-label="Last page"/>
        </div>
    </MudToolBar>
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50, 100];

    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int PageNumber { get; set; }
    [Parameter] public EventCallback<int> PageNumberChanged { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private int FirstItem => TotalCount == 0
        ? 0
        : (PageNumber - 1) * PageSize + 1;

    private int LastItem => Math.Min(PageNumber * PageSize, TotalCount);

    private Task ChangePageAsync(int pageNumber)
    {
        if (Disabled || TotalCount == 0 || pageNumber < 1 ||
            pageNumber > TotalPages || pageNumber == PageNumber)
            return Task.CompletedTask;

        return PageNumberChanged.InvokeAsync(pageNumber);
    }

    private Task ChangePageSizeAsync(int pageSize)
    {
        if (Disabled || pageSize == PageSize || !PageSizes.Contains(pageSize))
            return Task.CompletedTask;

        return PageSizeChanged.InvokeAsync(pageSize);
    }

}
