@page "/settings"

<AppPageTitle Title="Settings"/>

<AppPageShell Width="AppPageWidth.Standard"
              Title="Settings"
              Subtitle="Customize RasStudio Mono on this device"
              Icon="@Icons.Material.Filled.Settings">
    <MudTabs Elevation="0" Rounded="true">
        <MudTabPanel Text="General" Icon="@Icons.Material.Outlined.Tune">
            <ApplicationSettingsPanel/>
        </MudTabPanel>

        <MudTabPanel Text="RasHub" Icon="@Icons.Material.Outlined.Hub">
            <RasHubSettingsPanel/>
        </MudTabPanel>

        <MudTabPanel Text="Assistant" Icon="@Icons.Material.Outlined.Chat">
            <AssistantSettingsPanel/>
        </MudTabPanel>
    </MudTabs>
</AppPageShell>
