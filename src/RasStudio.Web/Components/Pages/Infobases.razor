@page "/infobases"
@implements IDisposable
@inject IRasInfobaseService RasInfobaseService
@inject IRasClusterService RasClusterService
@inject IRasEndpointService RasEndpointService
@inject IRasHubConnectionSettings ConnectionSettings
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Infobases> Logger
@inject NavigationManager Navigation

<AppPageTitle Title="Infobases"/>

<AppPageShell Width="AppPageWidth.Wide"
              Title="Infobases"
              Subtitle="Browse infobases through RasHub"
              Icon="@AppIcons.Infobase"
              Class="resource-table-page">
    <HeaderActions>
        <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Sync"
                       Disabled="@(_selectedEndpointId is null || _selectedClusterId is null || IsBusy)"
                       OnClick="RefreshShadowAsync">
                @(_syncingAll ? "Synchronizing…" : "Sync selected cluster")
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Key"
                       Disabled="@(_selectedEndpointId is null || _selectedClusterId is null || IsBusy)"
                       OnClick="RefreshShadowWithCredentialsAsync">
                With credentials
            </MudButton>
        </MudStack>
    </HeaderActions>
    <ChildContent>
        @if (!ConnectionSettings.Current.IsConfigured)
        {
            <MudPaper Class="app-card resource-table-empty" Elevation="1">
                <AppEmptyState Title="Connect to RasHub"
                               Description="Configure a RasHub connection before viewing infobases."
                               Icon="@Icons.Material.Outlined.Hub">
                    <Actions>
                        <MudButton Href="/settings"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Settings">
                            Open settings
                        </MudButton>
                    </Actions>
                </AppEmptyState>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="3" Class="resource-table-layout">
                <MudPaper Class="app-card resource-table-filters" Elevation="1">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudSelect T="Guid?"
                                       Label="RAS endpoint filter"
                                       Value="@_selectedEndpointId"
                                       ValueChanged="EndpointChangedAsync"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable
                                       Disabled="@IsBusy">
                                @foreach (var endpoint in _endpoints)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)endpoint.Id)">
                                        @endpoint.Name · @FormatEndpointAddress(endpoint)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="Guid?"
                                       Label="Cluster filter"
                                       Value="@_selectedClusterId"
                                       ValueChanged="ClusterChangedAsync"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable
                                       Disabled="@(_selectedEndpointId is null || _loadingClusters || IsBusy)">
                                @foreach (var cluster in _clusters)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)cluster.Id)">
                                        @cluster.Name · @FormatClusterAddress(cluster)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudTextField T="string"
                                              @bind-Value="_query"
                                              Label="Search"
                                              Placeholder="Name, description"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              MaxLength="200"
                                              Immediate
                                              DebounceInterval="350"
                                              OnDebounceIntervalElapsed="SearchChangedAsync"
                                              Clearable
                                              ClearIcon="@Icons.Material.Outlined.Close"
                                              OnClearButtonClick="ClearSearchAsync"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Outlined.Search"
                                              AdornmentAriaLabel="Search infobases"
                                              Disabled="@IsSearchDisabled"
                                              Class="flex-grow-1"/>
                                <MudTooltip Text="Reload persisted data">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                                                   Color="Color.Primary"
                                                   Disabled="@IsBusy"
                                                   OnClick="ReloadDataAsync"
                                                   aria-label="Reload infobases"/>
                                </MudTooltip>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                @if (_loadError is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudText Typo="Typo.body2">@_loadError</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RetryLoadAsync">
                                Retry
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }

                <MudPaper Class="app-card resource-table-card" Elevation="1">
                    <MudProgressLinear Indeterminate="@(_loading || _loadingEndpoints || _loadingClusters)"
                                       Color="Color.Primary"
                                       Class="@ProgressClass(_loading || _loadingEndpoints || _loadingClusters)"/>

                    <MudTable T="InfobaseRow"
                              Items="@_items"
                              Hover
                              FixedHeader
                              Elevation="0"
                              Breakpoint="Breakpoint.Md"
                              RowsPerPage="@int.MaxValue"
                              aria-busy="@_loading">
                        <HeaderContent>
                            <MudTh>Infobase</MudTh>
                            <MudTh>Location</MudTh>
                            <MudTh>Observed</MudTh>
                            <MudTh Class="text-right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Infobase">
                                <MudText Typo="Typo.body2">@context.Infobase.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(string.IsNullOrWhiteSpace(context.Infobase.Description)
                                        ? "No description"
                                        : context.Infobase.Description)
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @context.Infobase.Id.ToString("D")
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Location">
                                <MudText Typo="Typo.body2">@context.ClusterName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @context.RasEndpointName
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Observed">
                                <MudText Typo="Typo.body2">@FormatTime(context.Infobase.ObservedAt)</MudText>
                            </MudTd>
                            <MudTd DataLabel="Actions" Class="text-right">
                                @if (IsSyncing(context))
                                {
                                    <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Primary"/>
                                }
                                else
                                {
                                    <MudTooltip Text="Synchronize without cluster credentials">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Sync"
                                                       Color="Color.Primary"
                                                       Disabled="@IsBusy"
                                                       OnClick="@(() => RefreshOneAsync(context))"
                                                       aria-label="@($"Synchronize {context.Infobase.Name}")"/>
                                    </MudTooltip>
                                    <MudTooltip Text="Synchronize with cluster credentials">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Key"
                                                       Color="Color.Default"
                                                       Disabled="@IsBusy"
                                                       OnClick="@(() => RefreshOneWithCredentialsAsync(context))"
                                                       aria-label="@($"Synchronize {context.Infobase.Name} with credentials")"/>
                                    </MudTooltip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <AppEmptyState Title="No infobases found"
                                           Description="Change the filters or select a cluster and synchronize its shadow from RAS."
                                           Icon="@AppIcons.Infobase"/>
                        </NoRecordsContent>
                    </MudTable>

                    <ResourceTableFooter TotalCount="@_totalCount"
                                         PageSize="@_loadedPageSize"
                                         PageSizeChanged="PageSizeChangedAsync"
                                         PageNumber="@_loadedPageNumber"
                                         PageNumberChanged="PageChangedAsync"
                                         TotalPages="@_totalPages"
                                         Disabled="@IsBusy"/>
                </MudPaper>
            </MudStack>
        }
    </ChildContent>
</AppPageShell>
