@page "/ras-gates"

<RasStudioPageTitle Title="RasGate Instances"/>

<MudContainer MaxWidth="MaxWidth.False"
              Style="max-width: 2240px;"
              Class="py-8">

    <MudStack Spacing="6">

        <MudStack Spacing="1">
            <MudText Typo="Typo.h3">
                RasGate Instances
            </MudText>

            <MudText Typo="Typo.subtitle1"
                     Color="Color.Secondary">
                Manage RasGate connections and synchronization endpoints
            </MudText>
        </MudStack>

        <MudDivider/>

        <MudPaper Class="pa-8"
                  Elevation="1">

            <MudStack AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudIcon Icon="material-symbols-outlined/settings_ethernet"
                         Size="Size.Large"
                         Color="Color.Secondary"/>

                <MudText Typo="Typo.h6">
                    No RasGate instances connected
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary"
                         Align="Align.Center">
                    Connected RasGate instances will appear here.
                </MudText>

            </MudStack>

        </MudPaper>

    </MudStack>

</MudContainer>
