@page "/clusters"
@implements IDisposable
@inject IRasClusterService RasClusterService
@inject IRasEndpointService RasEndpointService
@inject IRasHubConnectionSettings ConnectionSettings
@inject ISnackbar Snackbar
@inject ILogger<Clusters> Logger
@inject NavigationManager Navigation

<AppPageTitle Title="Clusters"/>

<AppPageShell Width="AppPageWidth.Wide"
              Title="Clusters"
              Subtitle="Inspect cluster shadow owned by a RAS endpoint and refresh it through the assigned RasGate"
              Icon="@Icons.Material.Filled.Storage">
    <HeaderActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Sync"
                   Disabled="@(_selectedEndpointId is null || _loading || _refreshing)"
                   OnClick="RefreshShadowAsync">
            @(_refreshing ? "Refreshing…" : "Refresh from RAS")
        </MudButton>
    </HeaderActions>
    <ChildContent>
        @if (!ConnectionSettings.Current.IsConfigured)
        {
            <MudPaper Class="app-card" Elevation="1">
                <AppEmptyState Title="Connect to RasHub"
                               Description="Configure a RasHub connection before viewing clusters."
                               Icon="@Icons.Material.Outlined.Hub">
                    <Actions>
                        <MudButton Href="/settings"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Settings">
                            Open settings
                        </MudButton>
                    </Actions>
                </AppEmptyState>
            </MudPaper>
        }
        else if (!_loadingEndpoints && _loadError is not null && _endpoints.Count == 0)
        {
            <MudPaper Class="app-card" Elevation="1">
                <AppEmptyState Title="Unable to load RAS endpoints"
                               Description="@_loadError"
                               Icon="@Icons.Material.Outlined.CloudOff">
                    <Actions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Refresh"
                                   OnClick="ReloadEndpointsAsync">
                            Retry
                        </MudButton>
                    </Actions>
                </AppEmptyState>
            </MudPaper>
        }
        else if (!_loadingEndpoints && _endpoints.Count == 0)
        {
            <MudPaper Class="app-card" Elevation="1">
                <AppEmptyState Title="No active RAS endpoints"
                               Description="Add an active RAS endpoint, assign it to a RasGate, then refresh its cluster shadow."
                               Icon="@Icons.Material.Filled.Link">
                    <Actions>
                        <MudButton Href="/ras-endpoints"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Add">
                            Manage RAS endpoints
                        </MudButton>
                    </Actions>
                </AppEmptyState>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="3">
                <MudPaper Class="app-card" Elevation="1">
                    <MudStack Row
                              Wrap="Wrap.Wrap"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween"
                              Spacing="2">
                        <MudSelect T="Guid?"
                                   Label="RAS endpoint"
                                   Value="@_selectedEndpointId"
                                   ValueChanged="EndpointChangedAsync"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@(_loading || _refreshing || _loadingEndpoints)"
                                   Style="min-width: 280px;">
                            @foreach (var endpoint in _endpoints)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)endpoint.Id)">
                                    @endpoint.Name · @FormatEndpointAddress(endpoint)
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudTooltip Text="Reload persisted cluster shadow">
                            <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                                           Color="Color.Primary"
                                           Disabled="@(_selectedEndpointId is null || _loading || _refreshing)"
                                           OnClick="LoadPageAsync"
                                           aria-label="Reload cluster shadow"/>
                        </MudTooltip>
                    </MudStack>
                </MudPaper>

                @if (_loadError is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        <MudStack Row
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween"
                                  Spacing="2">
                            <MudText Typo="Typo.body2">@_loadError</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadPageAsync">
                                Retry
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }

                <MudPaper Class="app-card clusters-card" Elevation="1">
                    @if (_loading || _loadingEndpoints)
                    {
                        <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-2"/>
                    }

                    <MudTable T="RasCluster"
                              Items="@_page.Items"
                              Hover
                              Elevation="0"
                              Breakpoint="Breakpoint.Md"
                              RowsPerPage="@int.MaxValue"
                              Loading="@_loading">
                        <HeaderContent>
                            <MudTh>Cluster</MudTh>
                            <MudTh>Manager address</MudTh>
                            <MudTh>Observed</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Cluster">
                                <MudText Typo="Typo.body2">@context.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @context.Id.ToString("D")
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Manager address">
                                <MudText Typo="Typo.body2">@FormatClusterAddress(context)</MudText>
                            </MudTd>
                            <MudTd DataLabel="Observed">
                                <MudText Typo="Typo.body2">@FormatTime(context.ObservedAt)</MudText>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <AppEmptyState Title="No clusters in the shadow"
                                           Description="Refresh from RAS to rebuild shadow data after registering or changing this endpoint."
                                           Icon="@Icons.Material.Filled.Storage">
                                <Actions>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Outlined.Sync"
                                               Disabled="@(_selectedEndpointId is null || _refreshing)"
                                               OnClick="RefreshShadowAsync">
                                        Refresh from RAS
                                    </MudButton>
                                </Actions>
                            </AppEmptyState>
                        </NoRecordsContent>
                    </MudTable>

                    <MudDivider Class="my-3"/>

                    <MudStack Row
                              Wrap="Wrap.Wrap"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween"
                              Spacing="2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_page.TotalCount.ToString("N0") cluster(s)
                        </MudText>

                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudSelect T="int"
                                       Label="Per page"
                                       Value="@_pageSize"
                                       ValueChanged="PageSizeChangedAsync"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Disabled="@(_loading || _refreshing)">
                                <MudSelectItem Value="10">10</MudSelectItem>
                                <MudSelectItem Value="25">25</MudSelectItem>
                                <MudSelectItem Value="50">50</MudSelectItem>
                                <MudSelectItem Value="100">100</MudSelectItem>
                            </MudSelect>

                            @if (_page.TotalPages > 1)
                            {
                                <MudPagination Count="@_page.TotalPages"
                                               Selected="@_pageNumber"
                                               SelectedChanged="PageChangedAsync"
                                               ShowFirstButton
                                               ShowLastButton
                                               Disabled="@(_loading || _refreshing)"/>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudStack>
        }
    </ChildContent>
</AppPageShell>

@code {
    private const int EndpointPageSize = 100;

    private readonly CancellationTokenSource _disposeToken = new();
    private IReadOnlyList<RasEndpoint> _endpoints = [];
    private RasClusterPage _page = new([], 0, 1, 10, 0);
    private Guid? _selectedEndpointId;
    private string? _loadError;
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private bool _loadingEndpoints;
    private bool _loading;
    private bool _refreshing;
    private bool _initialized;
    private Guid? _appliedRequestedEndpointId;

    [Parameter]
    [SupplyParameterFromQuery(Name = "rasEndpointId")]
    public Guid? RequestedEndpointId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (ConnectionSettings.Current.IsConfigured)
        {
            await LoadEndpointsAsync();
            if (_selectedEndpointId is not null)
                await LoadPageAsync();
        }

        _appliedRequestedEndpointId = RequestedEndpointId;
        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized ||
            _loadingEndpoints ||
            RequestedEndpointId == _appliedRequestedEndpointId)
            return;

        _appliedRequestedEndpointId = RequestedEndpointId;
        var endpointId = _endpoints.Any(endpoint => endpoint.Id == RequestedEndpointId)
            ? RequestedEndpointId
            : _endpoints.FirstOrDefault()?.Id;

        if (endpointId == _selectedEndpointId)
            return;

        _selectedEndpointId = endpointId;
        _pageNumber = 1;
        _page = new RasClusterPage([], 0, 1, _pageSize, 0);
        await LoadPageAsync();
    }

    private async Task LoadEndpointsAsync()
    {
        try
        {
            _loadingEndpoints = true;
            _loadError = null;
            _endpoints = (await LoadAllEndpointsAsync())
                .Where(endpoint => endpoint.IsActive)
                .ToArray();
            _selectedEndpointId = _endpoints.Any(endpoint => endpoint.Id == RequestedEndpointId)
                ? RequestedEndpointId
                : _endpoints.FirstOrDefault()?.Id;
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load RAS endpoints for clusters");
            _loadError = GetErrorMessage(exception, "Unable to load RAS endpoints from RasHub.");
        }
        finally
        {
            _loadingEndpoints = false;
        }
    }

    private async Task<IReadOnlyList<RasEndpoint>> LoadAllEndpointsAsync()
    {
        var endpoints = new List<RasEndpoint>();

        for (var pageNumber = 1; ; pageNumber++)
        {
            var page = await RasEndpointService.GetPageAsync(
                pageNumber,
                EndpointPageSize,
                _disposeToken.Token);
            endpoints.AddRange(page.Items);

            if (pageNumber >= page.TotalPages || page.Items.Count == 0)
                return endpoints.DistinctBy(endpoint => endpoint.Id).ToArray();
        }
    }

    private async Task ReloadEndpointsAsync()
    {
        await LoadEndpointsAsync();
        if (_selectedEndpointId is not null && _loadError is null)
            await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        if (_loading || _selectedEndpointId is not { } endpointId)
            return;

        try
        {
            _loading = true;
            _loadError = null;
            var page = await RasClusterService.GetShadowPageAsync(
                endpointId,
                _pageNumber,
                _pageSize,
                _disposeToken.Token);

            if (page.TotalPages > 0 && _pageNumber > page.TotalPages)
            {
                _pageNumber = page.TotalPages;
                page = await RasClusterService.GetShadowPageAsync(
                    endpointId,
                    _pageNumber,
                    _pageSize,
                    _disposeToken.Token);
            }

            _page = page;
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to load cluster shadow for {RasEndpointId}",
                endpointId);
            _loadError = GetErrorMessage(exception, "Unable to load the cluster shadow from RasHub.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshShadowAsync()
    {
        if (_refreshing || _selectedEndpointId is not { } endpointId)
            return;

        try
        {
            _refreshing = true;
            var refresh = await RasClusterService.RefreshShadowAsync(
                endpointId,
                _disposeToken.Token);
            Snackbar.Add(
                $"Cluster shadow refreshed: {refresh.TotalCount:N0} cluster(s).",
                Severity.Success);
            _pageNumber = 1;
            await LoadPageAsync();
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to refresh cluster shadow for {RasEndpointId}",
                endpointId);
            Snackbar.Add(
                GetErrorMessage(exception, "Unable to refresh the cluster shadow through RasGate."),
                Severity.Error);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task EndpointChangedAsync(Guid? endpointId)
    {
        _selectedEndpointId = endpointId;
        _appliedRequestedEndpointId = endpointId;
        _pageNumber = 1;
        _page = new RasClusterPage([], 0, 1, _pageSize, 0);

        Navigation.NavigateTo(
            endpointId is { } id
                ? $"/clusters?rasEndpointId={id:D}"
                : "/clusters",
            replace: true);
        await LoadPageAsync();
    }

    private async Task PageChangedAsync(int page)
    {
        _pageNumber = page;
        await LoadPageAsync();
    }

    private async Task PageSizeChangedAsync(int pageSize)
    {
        _pageSize = pageSize;
        _pageNumber = 1;
        await LoadPageAsync();
    }

    private static string FormatEndpointAddress(RasEndpoint endpoint)
    {
        return endpoint.Host.Contains(':', StringComparison.Ordinal)
            ? $"[{endpoint.Host}]:{endpoint.Port}"
            : $"{endpoint.Host}:{endpoint.Port}";
    }

    private static string FormatClusterAddress(RasCluster cluster)
    {
        return cluster.Host.Contains(':', StringComparison.Ordinal)
            ? $"[{cluster.Host}]:{cluster.Port}"
            : $"{cluster.Host}:{cluster.Port}";
    }

    private static string FormatTime(DateTime value)
    {
        return value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string GetErrorMessage(Exception exception, string fallback)
    {
        return exception switch
        {
            RasHubApiException apiException when apiException.TraceId is not null =>
                $"{apiException.Message} Trace: {apiException.TraceId}",
            RasHubApiException apiException => apiException.Message,
            RasHubConnectionNotConfiguredException notConfigured => notConfigured.Message,
            _ => fallback
        };
    }

    public void Dispose()
    {
        _disposeToken.Cancel();
        _disposeToken.Dispose();
    }
}
