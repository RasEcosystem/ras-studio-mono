@page "/"
@implements IAsyncDisposable
@inject IRasGateService RasGateService
@inject IRasEndpointService RasEndpointService
@inject IRasHubConnectionSettings ConnectionSettings
@inject ApplicationDiagnostics Diagnostics
@inject TimeProvider TimeProvider
@inject ILogger<Home> Logger

<AppPageTitle Title="Home"/>

<AppPageShell Width="AppPageWidth.Wide"
              Title="Home"
              Subtitle="1C:Enterprise infrastructure management"
              Icon="@Icons.Material.Filled.Home"
              Class="home-page">
    <MudStack Spacing="6">
        <div class="home-card-grid">
            <div class="home-card">
                <MetricCard Title="Warnings"
                            Value="@Diagnostics.WarningCount.ToString("N0")"
                            Detail="Since Studio process start"
                            Icon="@Icons.Material.Outlined.Warning"
                            Color="Color.Warning"
                            ValueHref="/health-events?level=warnings"
                            ValueAriaLabel="View application warnings"/>
            </div>
            <div class="home-card">
                <MetricCard Title="Errors"
                            Value="@Diagnostics.ErrorCount.ToString("N0")"
                            Detail="Since Studio process start"
                            Icon="@Icons.Material.Outlined.ErrorOutline"
                            Color="Color.Error"
                            ValueHref="/health-events?level=errors"
                            ValueAriaLabel="View application errors"/>
            </div>
        </div>

        <div class="home-card-grid">
            <div class="home-card">
                <MetricCard Title="RasGates"
                            Value="@_rasGateCount"
                            Detail="@RasGateDetail"
                            Icon="@Icons.Material.Filled.SettingsEthernet"
                            Color="Color.Primary"
                            ValueHref="/ras-gates"
                            ValueAriaLabel="View RasGates"/>
            </div>
            <div class="home-card">
                <MetricCard Title="RAS endpoints"
                            Value="@_rasEndpointCount"
                            Detail="@RasEndpointDetail"
                            Icon="@Icons.Material.Filled.Link"
                            Color="Color.Primary"
                            ValueHref="/ras-endpoints"
                            ValueAriaLabel="View RAS endpoints"/>
            </div>
            <div class="home-card">
                <MetricCard Title="Clusters"
                            Value="—"
                            Detail="@ClusterDetail"
                            Icon="@Icons.Material.Filled.Storage"
                            Color="Color.Primary"
                            ValueHref="/clusters"
                            ValueAriaLabel="View clusters"/>
            </div>
        </div>
    </MudStack>
</AppPageShell>

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private Task _pollTask = Task.CompletedTask;
    private string _rasGateCount = "—";
    private string _rasEndpointCount = "—";

    private string RasGateDetail => ConnectionSettings.Current.IsConfigured
        ? "Gateways registered in RasHub"
        : "Connect RasHub in Settings";

    private string RasEndpointDetail => ConnectionSettings.Current.IsConfigured
        ? "RAS servers managed through RasGates"
        : "Connect RasHub in Settings";

    private string ClusterDetail => ConnectionSettings.Current.IsConfigured
        ? "View endpoint-owned cluster shadow"
        : "Connect RasHub in Settings";

    protected override async Task OnInitializedAsync()
    {
        if (ConnectionSettings.Current.IsConfigured)
        {
            try
            {
                var page = await RasGateService.GetPageAsync(
                    1,
                    1,
                    cancellationToken: _disposeToken.Token);
                _rasGateCount = page.TotalCount.ToString("N0");

                var endpointPage = await RasEndpointService.GetPageAsync(
                    1,
                    1,
                    _disposeToken.Token);
                _rasEndpointCount = endpointPage.TotalCount.ToString("N0");
            }
            catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
            {
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Unable to load RasHub dashboard counts");
            }
        }

        _pollTask = PollDiagnosticsAsync();
    }

    private async Task PollDiagnosticsAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), TimeProvider);

        try
        {
            while (await timer.WaitForNextTickAsync(_disposeToken.Token))
                await InvokeAsync(() => { StateHasChanged(); });
        }
        catch (OperationCanceledException) when (_disposeToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Home diagnostics polling stopped unexpectedly");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposeToken.Cancel();

        try
        {
            await _pollTask;
        }
        finally
        {
            _disposeToken.Dispose();
        }
    }

}
