@page "/"

<AppPageTitle Title="Home"/>

<AppPageShell Width="AppPageWidth.Wide"
              Title="Home"
              Subtitle="Administration and monitoring of your 1C:Enterprise environments"
              Icon="@Icons.Material.Filled.Home">

    <MudGrid Spacing="3">
        @foreach (var metric in OverviewMetrics)
        {
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Class="app-card" Style="height: 100%;" Elevation="1">
                    <MudStack Spacing="3" Style="height: 100%;">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Color="@metric.Color" Variant="Variant.Outlined" Size="Size.Medium">
                                <MudIcon Icon="@metric.Icon"/>
                            </MudAvatar>

                            <MudText Typo="Typo.subtitle1">@metric.Title</MudText>
                        </MudStack>

                        <a class="metric-value-link"
                           href="@metric.ValueHref"
                           aria-label="@metric.ValueAriaLabel">
                            <MudText Typo="Typo.h3">@metric.Value</MudText>
                        </a>

                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @metric.Description
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</AppPageShell>

@code {

    private static readonly IReadOnlyList<OverviewMetric> OverviewMetrics =
    [
        new(
            "RasGates",
            "0",
            "Gateways available through RasHub",
            Icons.Material.Filled.SettingsEthernet,
            Color.Primary,
            "/ras-gates",
            "View RasGates"),
        new(
            "Clusters",
            "0",
            "Discovered 1C:Enterprise clusters",
            Icons.Material.Filled.Storage,
            Color.Primary,
            "/clusters",
            "View clusters")
    ];

    private sealed record OverviewMetric(
        string Title,
        string Value,
        string Description,
        string Icon,
        Color Color,
        string ValueHref,
        string ValueAriaLabel);

}
