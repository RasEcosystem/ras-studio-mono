@page "/not-found"
@layout MainLayout

<AppPageTitle Title="Page not found"/>

<AppPageShell Width="AppPageWidth.Narrow"
              Title="Page not found"
              Subtitle="The requested page is not available"
              Icon="@Icons.Material.Outlined.SearchOff">

    <MudPaper Class="app-card" Elevation="1">

        <MudStack Spacing="4"
                  AlignItems="AlignItems.Center">

            <MudText Typo="Typo.h2" Align="Align.Center">404</MudText>

            <MudText Typo="Typo.body1"
                     Class="mud-text-secondary"
                     Align="Align.Center">
                Check the address or return to the Home page.
            </MudText>

            <MudDivider Class="my-2"
                        Style="width: 100%;"/>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Href="/"
                       StartIcon="@Icons.Material.Outlined.Home">
                Return home
            </MudButton>

        </MudStack>

    </MudPaper>
</AppPageShell>
