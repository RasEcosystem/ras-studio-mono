@inject ISettingsProvider<ApplicationSettings> SettingsProvider
@inject ISnackbar Snackbar
@inject ILogger<AssistantSettingsPanel> Logger

<MudForm Model="_settings"
         @ref="_form"
         ValidationDelay="0">

    <MudPaper Class="app-card" Elevation="1">
        <MudStack Spacing="4">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome"
                         Size="Size.Small"
                         Color="Color.Primary"/>

                <MudText Typo="Typo.h5">Assistant</MudText>
            </MudStack>

            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Configure the Ollama-compatible inference server used by the assistant.
            </MudText>

            <MudTextField T="string"
                          @bind-Value="_settings.InferenceServerUrl"
                          Label="Inference server URL"
                          Placeholder="http://192.168.253.25:11434"
                          HelperText="Base URL of the Ollama server"
                          Variant="Variant.Outlined"
                          InputType="InputType.Url"
                          Validation="@(new Func<string, string?>(ValidateInferenceServerUrl))"
                          FullWidth/>

            <MudTextField T="string"
                          @bind-Value="_settings.InferenceModel"
                          Label="Model"
                          Placeholder="Qwen3:latest"
                          HelperText="Ollama model name sent with each request"
                          Variant="Variant.Outlined"
                          Validation="@(new Func<string, string?>(ValidateInferenceModel))"
                          FullWidth/>
        </MudStack>
    </MudPaper>

    <MudStack Row
              Wrap="Wrap.Wrap"
              Justify="Justify.FlexEnd"
              Spacing="2"
              Class="mt-3">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Save"
                   Disabled="_saving"
                   OnClick="@SaveAsync">
            @(_saving ? "Saving…" : "Save changes")
        </MudButton>
    </MudStack>
</MudForm>

@code {
    private MudForm _form = null!;
    private ApplicationSettings _settings = new();
    private bool _saving;

    protected override void OnInitialized()
    {
        _settings = new ApplicationSettings
        {
            Theme = SettingsProvider.Settings.Theme,
            InferenceServerUrl = SettingsProvider.Settings.InferenceServerUrl,
            InferenceModel = SettingsProvider.Settings.InferenceModel
        };
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        await _form.ValidateAsync();

        if (!_form.IsValid)
        {
            return;
        }

        try
        {
            _saving = true;
            await SettingsProvider.UpdateAsync(new ApplicationSettings
            {
                Theme = SettingsProvider.Settings.Theme,
                InferenceServerUrl = _settings.InferenceServerUrl.Trim().TrimEnd('/'),
                InferenceModel = _settings.InferenceModel.Trim()
            });
            Snackbar.Add("Assistant settings saved.", Severity.Success);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to save assistant settings.");
            Snackbar.Add("Unable to save assistant settings.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? ValidateInferenceServerUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Inference server URL is required.";
        }

        return Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? null
            : "Enter an absolute HTTP or HTTPS URL.";
    }

    private static string? ValidateInferenceModel(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Model name is required."
            : null;
    }

}
