{
    "name": "$(ElectronPackageId)",
    "productName": "$(ElectronTitle)",
    "description": "$(Description)",
    "version": "$(Version)",
    "main": "main.js",
  "desktopName": "$(ElectronPackageId).desktop",
  "author": {
    "name": "$(Authors)"
  },
    "license": "$(License)",
    "executable": "$(TargetName)",
    "singleInstance": $(ElectronSingleInstance),
    "homepage": "$(ProjectUrl)",
    "splashscreen": {
        "imageFile": "$(ElectronSplashScreen)"
    },
    "scripts": {
        "start": "tsc -p ."
    },
    "dependencies": {
        "dasherize": "^2.0.0",
        "electron-updater": "^6.6.2",
        "image-size": "file:./ImageSizeShim",
        "socket.io": "^4.8.1",
        "electron-host-hook": "file:./ElectronHostHook"
    },
    "devDependencies": {
        "@types/node": "^22.18",
        "electron": "$(ElectronVersion)",
        "typescript": "^5.9.3"
    }
}
