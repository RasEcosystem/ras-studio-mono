{
    "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/refs/heads/master/packages/app-builder-lib/scheme.json",
    "compression": "maximum",
    "artifactName": "RasStudio-Mono-${version}-${os}-${arch}.${ext}",
    "linux": {
        "target": [
            "AppImage"
        ],
        "category": "Utility",
        "syncDesktopName": true,
        "icon": "bin/Assets/rasstudio.png",
        "desktop": {
            "entry": {
                "StartupWMClass": "com.rasecosystem.rasstudio-mono"
            }
        }
    },
    "win": {
        "target": [
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "portable",
                "arch": [
                    "x64"
                ]
            }
        ],
        "icon": "bin/Assets/rasstudio.ico"
    },
    "nsis": {
        "artifactName": "RasStudio-Mono-${version}-windows-${arch}-setup.${ext}",
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
    },
    "portable": {
        "artifactName": "RasStudio-Mono-${version}-windows-${arch}-portable.${ext}"
    }
}
